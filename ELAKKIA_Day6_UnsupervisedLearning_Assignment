import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans, DBSCAN
from sklearn.metrics import silhouette_score

customers = pd.DataFrame({
    "AnnualSpend": [20,22,25,27,30,75,78,80,85,88,40,42],
    "VisitsPerMonth": [2,3,2,4,3,8,9,8,10,9,4,5]
})

print(customers)

scaler = StandardScaler()
X_scaled = scaler.fit_transform(customers)

km = KMeans(n_clusters=3, random_state=42, n_init=10)
customers["Cluster"] = km.fit_predict(X_scaled)

print("\nCustomer Segments:")
print(customers)

plt.scatter(customers["AnnualSpend"], customers["VisitsPerMonth"],
             c=customers["Cluster"])
plt.xlabel("Annual Spending")
plt.ylabel("Visits Per Month")
plt.title("Customer Segmentation")
plt.show()

print("\nAverage Spending:")
print(customers.groupby("Cluster")["AnnualSpend"].mean())

for k in [2, 3, 4]:
    model = KMeans(n_clusters=k, random_state=42, n_init=10)
    labels = model.fit_predict(X_scaled)
    print("\nK =", k)
    print("Inertia:", model.inertia_)
    print("Silhouette Score:", silhouette_score(X_scaled, labels))

inertia = []

for k in range(1, 6):
    model = KMeans(n_clusters=k, random_state=42, n_init=10)
    model.fit(X_scaled)
    inertia.append(model.inertia_)

plt.plot(range(1, 6), inertia, marker="o")
plt.xlabel("Number of Clusters")
plt.ylabel("Inertia")
plt.title("Elbow Method")
plt.show()

db = DBSCAN(eps=0.8, min_samples=2)
labels = db.fit_predict(X_scaled)

print("\nDBSCAN Labels:", labels)
print("Noise Points:", np.sum(labels == -1))

plt.scatter(customers["AnnualSpend"], customers["VisitsPerMonth"],
             c=labels)
plt.xlabel("Annual Spending")
plt.ylabel("Visits Per Month")
plt.title("DBSCAN Clustering")
plt.show()
